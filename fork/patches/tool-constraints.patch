@@ -0,0 +1,751 @@
+"""serve/constrain.py - constrained decoding for the JSON response formats: a token mask per step, from llguidance.
+
+The engine (strata --serve, `mask=1` on GEN, INFO token_mask=1, or token_mask=2 when it can mask a whole MTP
+window) asks before every verify window with a line `MQ` (or `MQ d1 d2 ...`, the drafts it would verify; only an
+engine that said token_mask=2 sends them); the server answers on stdin with one line:
+
+    MF                  free: the window runs as always (drafts, MTP) - the thinking, before the answer
+    MF cut=<id,...>     free, but the window's accepted tokens end at the first of these ids (</think>), so no draft
+                        past the end of the thinking is accepted unconstrained
+    MK <base64>         constrained: a one-token window (no drafts), and the head's logits outside the mask are set to
+                        -1e30 before the request's own sampler picks (greedy or sampled, penalties as asked).  The mask
+                        is little-endian uint32 words, bit v = token v allowed; words past the end are "not allowed".
+    MKN <n> <b0> ...    constrained, n rows: row i is the mask for the token after the engine's i-th draft (the same
+                        encoding as MK).  Only sent in answer to `MQ d...`; an engine that knows only MK never sees it.
+
+The grammar is the request's JSON schema (json_object: any object), and with tools also "<tool_call> + anything": a
+turn that calls tools stays a tool call (the server's own parser reads it), a turn that answers is the schema's JSON
+token for token.  Leading whitespace is allowed before either.  The thinking is not constrained: the mask starts
+after </think> (or at once when the prompt has already closed it, i.e. thinking off).
+
+llguidance is optional (`pip install llguidance`): without it, or with an engine that does not say token_mask=1 or
+token_mask=2, nothing changes - the prompt directive and the validation after the turn (serve/structured.py) remain
+the contract.
+The validation also stays ON with the mask: it is the check that the mask and the schema agree, not the guarantee.
+"""
+from __future__ import annotations
+import base64
+import json
+import re
+import threading
+from collections import OrderedDict
+
+# the custom_calls grammar (T2a) assembles its special tokens from the frontend constants, never from
+# text literals; frontend imports nothing from serve, so this top-level import cannot cycle.
+from serve.frontend import CALL_END, FUNC_END, FUNC_START, PARAM_END, PARAM_START
+
+try:
+    import llguidance as _llg
+    import llguidance.numpy  # noqa: F401  (part of the package; imported so a broken install fails here)
+except ImportError:                     # optional dependency
+    _llg = None
+
+KEY = "_strata_constraint"              # the sampling dict's key the engines read (never sent to the engine as text)
+THINK_END = b"</think>"
+TOOL_CALL = "<tool_call>"
+SPECIAL_MARK = b"\xff"                  # llguidance: a special token's bytes are 0xFF + its text
+_noted: set[str] = set()
+_note_lock = threading.Lock()
+
+
+def available() -> bool:
+    return _llg is not None
+
+
+def note_once(msg: str) -> None:
+    with _note_lock:
+        if msg in _noted:
+            return
+        _noted.add(msg)
+    print(f"[strata] {msg}", flush=True)
+
+
+# ------------------------------------------------------------------------------------------------ the vocabulary
+def _vocab_bytes(tok):
+    """-> (bytes per token id, special ids).  Three tokenizers are known: the tests' ByteTokenizer (one id per byte,
+    SPECIALS after 256), and the pack's tokenizer (strata_tokenizer.Tokenizer: `token_bytes(id)`, the token types
+    from token_type.json - 3 = control, 4 = user-defined such as <think> / <tool_call> - are special)."""
+    specials_list = getattr(tok, "SPECIALS", None)
+    if specials_list is not None and not hasattr(tok, "token_bytes"):          # ByteTokenizer
+        tokens = [bytes([i]) for i in range(256)] + [SPECIAL_MARK + s.encode() for s in specials_list]
+        return tokens, list(range(256, 256 + len(specials_list)))
+    if not hasattr(tok, "token_bytes"):
+        raise ValueError("this tokenizer has no token_bytes(); constrained decoding needs the bytes of every token")
+    n = None
+    for attr in ("n_vocab", "vocab_size"):
+        v = getattr(tok, attr, None)
+        n = v() if callable(v) else v
+        if isinstance(n, int) and n > 0:
+            break
+    if not isinstance(n, int) or n <= 0:
+        toks = getattr(tok, "tokens", None)
+        n = len(toks) if toks is not None else None
+    if not isinstance(n, int) or n <= 0:
+        raise ValueError("cannot tell this tokenizer's vocabulary size")
+    types = getattr(tok, "types", None) or getattr(tok, "token_types", None)
+    tokens, specials = [], []
+    for i in range(n):
+        b = tok.token_bytes(i) or b""
+        special = types is not None and i < len(types) and types[i] in (3, 4)
+        if special:
+            specials.append(i)
+            b = SPECIAL_MARK + b
+        tokens.append(bytes(b))
+    return tokens, specials
+
+
+class _Wrapper:
+    """What llguidance.TokenizerWrapper reads: tokens (bytes), eos/bos ids, special ids, and a callable tokenizer."""
+    def __init__(self, tok, tokens, specials, eos):
+        self.tok, self.tokens, self.special_token_ids = tok, tokens, specials
+        self.eos_token_id, self.bos_token_id = eos, None
+
+    def __call__(self, s):
+        if isinstance(s, (bytes, bytearray)):
+            s = bytes(s).decode("utf-8", errors="replace")
+        return list(self.tok.encode(s))
+
+
+class Vocab:
+    """The tokenizer as llguidance sees it.  Built once per server (about a second for 248K tokens)."""
+    def __init__(self, tok, stop_ids):
+        if _llg is None:
+            raise ValueError("llguidance is not installed")
+        self.tok = tok
+        self.tokens, self.specials = _vocab_bytes(tok)
+        self.n = len(self.tokens)
+        im_end = tok.encode("<|im_end|>", parse_special=True)
+        eos = im_end[0] if len(im_end) == 1 else min(stop_ids)
+        self.eos = sorted(set(stop_ids) | {eos})
+        self.lltok = _llg.LLTokenizer(_llg.TokenizerWrapper(_Wrapper(tok, self.tokens, self.specials, eos)),
+                                      eos_token=self.eos)
+        self._tool_cache_lock = threading.Lock()
+        self._tool_masks = OrderedDict()
+        # the window cut while the thinking runs: </think> when it is one token, else every token ending in '>'
+        one = self.single(THINK_END.decode())
+        self.cut = [one] if one is not None else [i for i, b in enumerate(self.tokens) if b.endswith(b">")]
+        # the cut ids for a draft lookahead (1-1): the think_end cut above, plus <tool_call> when the tokenizer
+        # writes it as one special token - both end the constrained turn, so a draft at or past them is not fed
+        tool = self.single(TOOL_CALL)
+        self.cut_ids = list(self.cut) + ([tool] if tool is not None and tool not in self.cut else [])
+
+    def single(self, text: str):
+        """The id of `text` when the tokenizer writes it as ONE special token (<tool_call>, </think>), else None."""
+        ids = self.tok.encode(text, parse_special=True)
+        if len(ids) == 1 and ids[0] in set(self.specials):
+            return ids[0]
+        return None
+
+    def literal(self, text: str) -> str:
+        """`text` in a Lark rule: the special token itself when the model has one for it, else the string."""
+        one = self.single(text)
+        return f"<[{one}]>" if one is not None else json.dumps(text)
+
+    def bytes_of(self, t: int) -> bytes:
+        return self.tokens[t] if 0 <= t < self.n else b""
+
+
+# ------------------------------------------------------------------------------------------------ the grammar
+def format_of(sampling: dict):
+    """The request's JSON (or lark) format from its sampling dict (the request itself): chat's
+    response_format, or the Responses API's text.format.  None: plain text (nothing to constrain).
+    A lark response_format ({type: "lark", grammar: "<lark text>"}) passes through unchanged: llguidance
+    reads lark natively, so the grammar string is the whole constraint (a GBNF client converts first with
+    grammar_from("gbnf", ...) and sends the result).  A lark without a non-empty string grammar is not a
+    format - the same treatment as an unknown type (None)."""
+    rf = sampling.get("response_format")
+    if rf is None and isinstance(sampling.get("text"), dict):
+        fmt = sampling["text"].get("format")
+        if isinstance(fmt, dict) and fmt.get("type") == "json_schema":
+            rf = {"type": "json_schema", "json_schema": {k: fmt[k] for k in ("name", "schema", "strict") if k in fmt}}
+        elif isinstance(fmt, dict) and fmt.get("type") == "json_object":
+            rf = {"type": "json_object"}
+    if not isinstance(rf, dict):
+        return None
+    if rf.get("type") == "lark":
+        return rf if isinstance(rf.get("grammar"), str) and rf["grammar"] else None
+    if rf.get("type") not in ("json_object", "json_schema"):
+        return None
+    return rf
+
+
+# Responses namespaces are flattened internally as namespace.member. Match
+# qualified ASCII segments; grammar regexes must escape the literal dots.
+_NAME_SAFE = re.compile(r"[A-Za-z0-9_-]+(?:\.[A-Za-z0-9_-]+)*")
+
+
+def safe_tool_names(tools) -> list[str]:
+    """The declared tool names a grammar can enumerate: the request's tools array (template form {name, ...} or
+    OpenAI form {type: function, function: {name, ...}} - the same array the route built from its own
+    template_tools()/openai_tools() call), filtered to qualified ASCII identifiers. The server's persistent guard rejects
+    the request if any name is filtered out; direct grammar callers choose their own invalid-name policy."""
+    out = []
+    for t in tools or []:
+        if not isinstance(t, dict):
+            continue
+        name = t.get("name")
+        if name is None and isinstance(t.get("function"), dict):
+            name = t["function"].get("name")
+        if isinstance(name, str) and _NAME_SAFE.fullmatch(name) and name not in out:
+            out.append(name)
+    return out
+
+
+# custom tool grammars: the measured shape of notes/probes/t2_probe7.py (extracted, not retyped).
+# The name choice excludes prefix pairs longest-first; each call is the name literal, the open tag,
+# the input parameter and one value lexeme that ends at the parameter close tag, then the function
+# and call close tags.  No look-ahead, no WS branch inside the calls branch (W5 panic).
+
+
+# T3 (spec item 3): the body binds only when the tokenizer holds the call opener as ONE
+# token (checked per vocabulary, notes/T3-impl.md); the envelope tokens ride vocab.literal
+# so both pack shapes match.
+
+def _def_esc(d):
+    return d.replace("\\", "\\\\").replace("/", "\\/").replace("\n", "\\n")
+
+
+def _value_lex(d):
+    return "/" + _def_esc(d) + "\\n" + PARAM_END.replace("/", "\\/") + "/"
+
+
+def _custom_calls_grammar(entries, vocab, body_bound=True):
+    names = [e["name"] for e in entries]
+    kept = []
+    for n in sorted(set(names), key=lambda n: (-len(n), n)):
+        if not any(k != n and k.startswith(n) for k in kept):
+            kept.append(n)
+    rules, choice = [], []
+    for i, e in enumerate(entries):
+        if e["name"] not in kept:
+            continue
+        if body_bound:          # T3 (spec item 3 + the T3d lesson): the envelope tokens ride
+                                # vocab.literal, so the grammar matches a pack that holds them as
+                                # ONE type-4 token and one that writes them as text - the measured
+                                # marker-byte refusal at the close was the plain-text closer literal
+            rules.append(f't{i}: "{e["name"]}" ">" "\\n" '
+                         f'{vocab.literal(PARAM_START)} "input" ">" "\\n" '
+                         f'{_value_lex(e["definition"])} "\\n" {vocab.literal(FUNC_END)} "\\n" '
+                         f'{vocab.literal(CALL_END)}')
+        else:                   # the T3d fallback: a vocabulary without the opener as ONE token gets
+                                # the name enumeration only - the body stays the free REST (spec item 3)
+            rules.append(f't{i}: "{e["name"]}" ">"')
+        choice.append(f"t{i}")
+    lines = ["start: WS? answer", "WS: /[ \\t\\r\\n]+/", "answer: calls | PROSE",
+             "PROSE: /[^<][\\s\\S]*/", "REST: /[\\s\\S]*/",
+             f'calls: {vocab.literal(TOOL_CALL)} "\\n" {vocab.literal(FUNC_START)} ( ' + " | ".join(choice) + " ) REST"] + rules
+    return "\n".join(lines) + "\n", kept
+
+
+def grammar(rf: dict | None, with_tools: bool, vocab: Vocab, tool_names=None) -> str:
+    """The Lark grammar: optional whitespace, then the schema's JSON - or, with tools, a tool call.
+    With no format but tools (the legacy bare-call grammar helper), the choice is the call or
+    PROSE: prose cannot START with '<' (a tag or '<tool_call' text must go through the calls branch, where
+    the name sits behind the enum) but a '<' later in the text stays free (measured: masked=0, EOS ok).
+    `tool_names`: when a non-empty list is given, the call's name sits behind a literal
+    single-choice regex (only these names, with a maximal-munch lookahead) instead of being free; the body
+    after the name stays the free REST, as always (the server's tool-call parser reads it, v3 lesson)."""
+    if rf is None:                                   # legacy bare-call grammar for direct callers
+        if not with_tools:
+            raise ValueError("the bare-call grammar needs tools")
+        names = [n for n in (tool_names or []) if _NAME_SAFE.fullmatch(n)]
+        lines = ["start: WS? answer",
+                 "WS: /[ \\t\\r\\n]+/",
+                 "answer: calls | PROSE",
+                 "PROSE: /[^<][\\s\\S]*/"]
+        if names:
+            alt = "|".join(re.escape(n) for n in sorted(names, key=lambda n: (-len(n), n)))
+            lines += [f'calls: {vocab.literal(TOOL_CALL)} WS? NAME REST',
+                      f"NAME: /(?:{alt})[\\s<]/",
+                      "REST: /[\\s\\S]*/"]
+        else:
+            lines += [f"calls: {vocab.literal(TOOL_CALL)} REST",
+                      "REST: /[\\s\\S]*/"]
+        return _llg.LLMatcher.grammar_from_lark("\n".join(lines) + "\n")
+    if rf["type"] == "lark":
+        # the user's own lark grammar (format_of's passthrough): llguidance reads lark natively, so the
+        # text goes to the matcher as it stands - no JSON branch, no calls branch (the grammar itself
+        # decides what the turn may be).  A grammar llguidance cannot compile leaves Constraint() with
+        # m.is_error() -> the caller's _with_constraint catches it and drops the mask (free decoding,
+        # never a 502), the same fallback as an uncompilable schema.
+        g = rf.get("grammar")
+        if not isinstance(g, str) or not g:
+            raise ValueError("lark without a grammar string")
+        return _llg.LLMatcher.grammar_from_lark(g)
+    if rf["type"] == "custom_calls":
+        # T2a: custom tool grammars (the spec item 2).  The route passes the entries it built from the
+        # request's custom tools ({name, definition}, definition a grammar text the value lexeme embeds);
+        # the answer is the probe7 calls shape or PROSE.  The caller pairs this grammar with
+        # Constraint(custom_calls=True): the mask stays live through the whole call (no tag or separator
+        # release) and the closing call-end token frees the turn.  An empty or all-unsafe entry list
+        # raises: the caller's existing handler drops the mask (free decoding, never a 502).
+        entries = rf.get("entries")
+        kept = [e for e in (entries or [])
+                if isinstance(e, dict) and isinstance(e.get("name"), str)
+                and _NAME_SAFE.fullmatch(e["name"]) and isinstance(e.get("definition"), str)]
+        if not kept:
+            raise ValueError("custom_calls without a usable entry")
+        # T3 (spec item 3, the T3d lesson): the body binds only when the tokenizer holds the
+        # call opener as ONE type-4 token; else the name enumeration stays and the body stays
+        # the free REST
+        body = vocab.single(TOOL_CALL) is not None
+        return _llg.LLMatcher.grammar_from_lark(_custom_calls_grammar(kept, vocab, body)[0])
+    if rf["type"] == "json_object":
+        schema = {"type": "object"}
+    else:
+        schema = (rf.get("json_schema") or {}).get("schema")
+        if not isinstance(schema, dict):
+            raise ValueError("json_schema without a schema object")
+    names = [n for n in (tool_names or []) if _NAME_SAFE.fullmatch(n)]
+    lines = ["start: WS? answer",
+             "WS: /[ \\t\\r\\n]+/",
+             "answer: json" + (" | calls" if with_tools else ""),
+             "json: %json " + json.dumps(schema, ensure_ascii=False)]
+    if with_tools:
+        # the call itself is not constrained here: the server's tool-call parser reads it as it always did.
+        # Anything may follow the opening tag - a tokenizer that writes <tool_call> as plain text (no special
+        # token, so feed() cannot free the turn) must still be able to finish the call.
+        if names:
+            # opt-in (T3a/T3d): the declared names are a literal single choice right after the tag (an undecided
+            # whitespace run may sit between them); everything past the name stays REST.
+            # T3d: llguidance 1.9.1 rejects look-around in a regex literal, so the maximal-munch lookahead
+            # (?![\w-]) is replaced by a mandatory delimiter class [\s<] after the alternation (measured in
+            # scratch/t3v_corr.py: with a prefix pair like exec/exec_command the grammar stays on the longer
+            # branch after 'exec', pinning the longest name).  Longest-first ordering keeps that pinning for
+            # llguidance's prioritized alternation. Qualified names contain dots:
+            # escape each name so the separator cannot match an arbitrary byte.
+            alt = "|".join(re.escape(n) for n in sorted(names, key=lambda n: (-len(n), n)))
+            lines += [f'calls: {vocab.literal(TOOL_CALL)} WS? NAME REST',
+                      f"NAME: /(?:{alt})[\\s<]/",
+                      "REST: /[\\s\\S]*/"]
+        else:
+            lines += [f"calls: {vocab.literal(TOOL_CALL)} REST",
+                      "REST: /[\\s\\S]*/"]
+    return _llg.LLMatcher.grammar_from_lark("\n".join(lines) + "\n")
+
+
+# ------------------------------------------------------------------ a masked window with drafts (1-1)
+def masks_for_window(m, drafts, cut_ids):
+    """The masks for rows 0..k of one verify window: row 0 for the token the head picks now, row i for the token
+    after the engine's i-th draft (so an MTP window stays constrained token by token).  The matcher's state is
+    restored to what it was on entry (rollback in a finally); a rollback failure raises RuntimeError (1-5).
+
+    How many drafts are valid is probed on a deep copy, one token at a time: llguidance's validate_tokens reports
+    k=0 for some single-byte tokens that the grammar accepts (':' after a key), and a refused consume leaves the
+    matcher in a permanent error state that rollback cannot undo (measured, llguidance 1.9.1).  The copy takes the
+    error instead; the original only consumes drafts the copy already accepted, so its consume cannot fail.
+    There is one row per token the copy consumed, plus the head's row: when the grammar ends inside the window the
+    last row is the EOS-only mask, which is what lets the window stop there."""
+    drafts = list(drafts)
+    for i, d in enumerate(drafts):            # think_end / tool_call sit outside the grammar: cut before them
+        if d in cut_ids:
+            drafts = drafts[:i]
+            break
+    k = 0
+    if drafts:
+        probe = m.deep_copy()
+        for d in drafts:
+            if not probe.consume_tokens([d]):  # the first token that leaves the grammar: no rows past it
+                break
+            k += 1
+    masks = [m.compute_bitmask()]
+    done = 0
+    try:
+        for d in drafts[:k]:                  # consume one draft at a time, one row of the window per step
+            if not m.consume_tokens([d]):     # accepted on the copy, so this should not happen; keep the rows so far (1-5)
+                note_once("constrained decoding: a validated draft was refused during the mask lookahead; "
+                          "the masked window keeps the rows up to it")
+                break
+            done += 1
+            if m.is_stopped():
+                # the grammar ends here.  Every draft was consumed (the engine will ask for the token after
+                # the last one): its row is the EOS-only mask.  Drafts remain (they sit past the end): the
+                # window is cut at the end - no row past it (test_6; a consume past it would error anyway).
+                if done == k and k == len(drafts):
+                    masks.append(m.compute_bitmask())
+                break
+            masks.append(m.compute_bitmask())
+    finally:
+        if done and not m.rollback(done):
+            raise RuntimeError("llguidance rollback failed")
+    return masks
+
+
+# ------------------------------------------------------------------------------------------------ one turn
+class Constraint:
+    """One generation pass of one request: the matcher, and whether the answer (the constrained part) has started."""
+    def __init__(self, vocab: Vocab, grammar_text: str, armed: bool, name_enum: bool = False,
+                 custom_calls: bool = False):
+        # T2a (custom_calls): the mask stays live through the whole call; the closing call-end token
+        # frees the turn.  call_end is None when the tokenizer has no single token for it (then the
+        # release rides on the consume-refusal path only, the probe7 finding).
+        self.custom_calls = bool(custom_calls)
+        self.call_end = vocab.single(CALL_END)
+
+        self.vocab, self.armed = vocab, armed
+        self.m = _llg.LLMatcher(vocab.lltok, grammar_text, log_level=0)
+        if self.m.is_error():
+            raise ValueError(f"grammar: {self.m.get_error()}")
+        self.tail = b""
+        self.failed = None                  # why the mask was given up (the validation after the turn then decides)
+        self.masked = 0                     # tokens decoded under a mask (diagnostics, tests)
+        self.tool_call = vocab.single(TOOL_CALL) # its id, when the model has one token for it
+        # T3a (opt-in): with an enumerated call the release waits for the name - the tag alone no longer frees
+        # the turn; the grammar masks the name's bytes, and a refused consume lands on the existing failed
+        # downgrade below (a refused consume is a permanent matcher error, rollback cannot undo it - measured).
+        self.name_enum = bool(name_enum)
+        self.await_name = False             # the tag was fed under name_enum: the next tokens are the name
+        self.name_len = 0                   # name-enum: non-separator tokens consumed since the tag
+
+    # --- the engine's question
+    def active(self) -> bool:
+        return self.armed and self.failed is None and not self.m.is_error()
+
+    def mask(self) -> bytes | None:
+        """The packed mask for the next token, or None when the next token is free."""
+        if not self.active():
+            return None
+        return self.m.compute_bitmask()
+
+    def reply(self, drafts=None) -> str:
+        """The answer to the engine's MQ line (without the newline).  `drafts` (1-2): the engine's draft tokens
+        for this window, sent only by an engine that said token_mask=2; empty or None keeps the one-row answer."""
+        if drafts and self.armed and self.failed is None and not self.m.is_error():
+            try:
+                masks = masks_for_window(self.m, drafts, self.vocab.cut_ids)
+            except Exception as e:                        # 1-5: rollback or matcher failure - drop the mask, log it
+                self.failed = str(e).splitlines()[0][:160] or "mask lookahead failed"
+                note_once(f"constrained decoding: gave the mask up in a turn ({self.failed}); "
+                          "the turn is validated after")
+            else:
+                self.masked += len(masks)
+                if len(masks) == 1:                       # 1-3: one row keeps the current MK form (old-engine safe)
+                    return "MK " + base64.b64encode(masks[0]).decode("ascii")
+                rows = " ".join(base64.b64encode(b).decode("ascii") for b in masks)
+                return f"MKN {len(masks)} {rows}"
+        bits = self.mask()
+        if bits is None:
+            if not self.armed and self.vocab.cut:
+                return "MF cut=" + ",".join(str(i) for i in self.vocab.cut)
+            return "MF"
+        self.masked += 1
+        return "MK " + base64.b64encode(bits).decode("ascii")
+
+    # --- what came out
+    def feed(self, t: int) -> None:
+        """A token the engine emitted (in order)."""
+        if self.failed is not None:
+            return
+        if self.custom_calls:
+            # T2a (probe7 measured): no tag / separator release - the mask stays live through the whole
+            # call; the closing CALL_END frees the turn, a refused consume lands on the existing
+            # downgrade (failed set, reply -> MF, the validation after the turn decides).
+            if not self.armed:
+                self.tail = (self.tail + self.vocab.bytes_of(t))[-64:]
+                if self.tail.endswith(THINK_END):
+                    self.armed = True
+                return
+            if not self.m.consume_token(t):
+                self.failed = "outside grammar"
+                note_once("constrained decoding: gave the mask up in a custom_calls turn (token outside "
+                          "the grammar); the turn is validated after")
+                return
+            if t == self.tool_call:
+                self.await_name = True
+            elif self.await_name and self.call_end is not None and t == self.call_end:
+                self.await_name = False
+                self.armed = False
+                self.failed = "tool call"
+            return
+        if not self.armed:
+            self.tail = (self.tail + self.vocab.bytes_of(t))[-64:]
+            if self.tail.endswith(THINK_END):
+                self.armed = True
+            return
+        # --- a tool call: the turn is free from here (unless the call's names are enumerated, T3a: the
+        #     release waits for the name, the grammar masks its bytes, a rule-breaker lands on failed below)
+        if self.tool_call is not None and t == self.tool_call and not self.name_enum:
+            self.armed = False                  # a tool call: the turn is free from here (not validated)
+            self.failed = "tool call"           # mask() -> None, reply() -> "MF" for the rest of the turn
+            return
+        if not self.m.consume_token(t):
+            self.failed = self.m.get_error() or f"token {t} is outside the grammar"
+            why = (self.failed.strip().splitlines() or ["?"])[0][:160]
+            note_once(f"constrained decoding: gave the mask up in a turn ({why}); the turn is validated after")
+            return
+        if self.name_enum and self.tool_call is not None and t == self.tool_call:
+            self.await_name = True          # the tag sat in the grammar and is consumed: the name is next
+        if self.await_name:
+            # the separator after the enumerated name frees the turn (_all_free() can never fire on a byte
+            # vocabulary: REST compiles to the valid-UTF-8 character set and the invalid single bytes stay
+            # masked forever - measured 2026-10-26, 82/263 tokens, so the release below never reached):
+            text = self.vocab.tok.decode([t])
+            if text and all(ch in " \t\r\n<" for ch in text) and self.name_len > 0:
+                self.await_name = False
+                self.armed = False
+                self.failed = "tool call"
+                return
+            if not (text and all(ch in " \t\r\n<" for ch in text)):
+                self.name_len += 1          # a name token (separators before the name do not count)
+        if self.await_name and self._all_free():
+            # the name is behind us and the body is the free REST: the turn is free exactly where the
+            # tag-only release used to free it one token earlier (the parser reads the call as it always did)
+            self.await_name = False
+            self.armed = False
+            self.failed = "tool call"
+
+    def _all_free(self) -> bool:
+        """True when the matcher's next mask allows every token of the vocabulary: the grammar is past the
+        enumerated name, into REST (anything may follow) - the point where a name-enumerated call frees the
+        turn.  A refused consume can never reach here (it sets failed above and the mask is not asked again)."""
+        bits = self.m.compute_bitmask()
+        nwords = (self.vocab.n + 31) // 32
+        if 4 * nwords > len(bits):              # words past the end are "not allowed": not free
+            return False
+        for w in range(nwords):
+            word = int.from_bytes(bits[4 * w:4 * w + 4], "little")
+            bits_in = min(32, self.vocab.n - 32 * w)
+            if word & ((1 << bits_in) - 1) != (1 << bits_in) - 1:
+                return False                    # one in-vocab token is masked out: still constrained
+        return True
+
+    def observe(self, ids) -> None:
+        """Tokens the server put into the stream itself (the thinking budget's wrap-up, which ends in </think>)."""
+        for t in ids:
+            if self.armed:
+                break
+            self.feed(t)
+
+    @staticmethod
+    def allowed(bits: bytes, t: int) -> bool:
+        w = t >> 5
+        return 4 * w + 4 <= len(bits) and (int.from_bytes(bits[4 * w:4 * w + 4], "little") >> (t & 31)) & 1 == 1
+
+    def mock_replay(self, script, max_new, cancel, delay=0.0):
+        """MockEngine under a mask: a "model" that wants to write `script`.  Where the mask forbids its next token it
+        drops it and goes on with the rest (prose around the JSON disappears, a wrongly typed value loses its quotes);
+        when the script runs out it ends the turn if the grammar may end, else takes the grammar's forced tokens."""
+        import time
+        i, out = 0, 0
+        while out < max_new and not cancel.is_set():
+            if delay:
+                time.sleep(delay)
+            bits = self.mask()
+            if bits is not None:
+                self.masked += 1
+            t = None
+            while i < len(script):
+                cand = script[i]
+                i += 1
+                if bits is None or self.allowed(bits, cand):
+                    t = cand
+                    break
+            if t is None:                                        # the script is used up
+                if bits is None:
+                    return
+                eos = next((e for e in self.vocab.eos if self.allowed(bits, e)), None)
+                ff = self.m.compute_ff_tokens()
+                t = eos if eos is not None else (ff[0] if ff else None)
+                if t is None:
+                    return                                       # nothing forced: the turn ends short ("length")
+            self.feed(t)
+            out += 1
+            yield t
+            if t in self.vocab.eos:
+                return
+
+
+class ToolNameConstraint:
+    """Persistent Qwen XML name mask, including thinking and every call.
+
+    Unlike the original answer|calls grammar, prose and the end of a name never
+    release this guard. It is a byte automaton over the tokenizer's real pieces,
+    so split tags, merged pieces and speculative windows have the same rule.
+    An optional JSON constraint is intersected with it. Errors are never MF.
+    """
+    OPENER = b'<function='
+    WS = b' \t\r\n'
+
+    def __init__(self, vocab, names, inner=None):
+        if not names or any(not isinstance(n, str) or not _NAME_SAFE.fullmatch(n) for n in names):
+            raise ValueError('strict tool names must be non-empty ASCII identifiers')
+        self.vocab, self.inner = vocab, inner
+        self.names = frozenset(n.encode('ascii') for n in names)
+        self.prefixes = {n[:i] for n in self.names for i in range(1, len(n) + 1)}
+        self.state = (0, b'')
+        self.failed = None
+        self.masked = 0
+        with vocab._tool_cache_lock:
+            if not hasattr(vocab, '_tool_pieces'):
+                special = set(vocab.specials)
+                pieces = tuple(b[1:] if i in special else b for i, b in enumerate(vocab.tokens))
+                buckets = {}
+                for i, b in enumerate(pieces):
+                    if b:
+                        buckets.setdefault(b[0], []).append(i)
+                vocab._tool_pieces = pieces
+                vocab._tool_buckets = buckets
+                vocab._tool_equals = tuple(i for i, b in enumerate(pieces) if b'=' in b)
+        self.pieces = vocab._tool_pieces
+        key = tuple(sorted(self.names))
+        with vocab._tool_cache_lock:
+            self.cache = vocab._tool_masks.setdefault(key, OrderedDict())
+            vocab._tool_masks.move_to_end(key)
+            while len(vocab._tool_masks) > 8:
+                vocab._tool_masks.popitem(last=False)
+
+    def active(self):
+        return self.failed is None
+
+    def _step(self, state, token):
+        mode, tail = state
+        if token in self.vocab.eos:
+            return state if mode == 0 else None
+        for ch in self.pieces[token]:
+            if mode == 0:
+                tail += bytes((ch,))
+                while tail and not self.OPENER.startswith(tail):
+                    tail = tail[1:]
+                if tail == self.OPENER:
+                    mode, tail = 1, b''
+            elif ch == ord('>') and tail in self.names:
+                mode, tail = 0, b''
+            elif ch in self.WS and (not tail or tail in self.names):
+                if tail:
+                    mode = 2
+            elif mode == 1 and tail + bytes((ch,)) in self.prefixes:
+                tail += bytes((ch,))
+            else:
+                return None
+        return mode, tail
+
+    def _bits(self, state):
+        with self.vocab._tool_cache_lock:
+            cached = self.cache.get(state)
+            if cached is not None:
+                self.cache.move_to_end(state)
+                return cached
+        mode, tail = state
+        size = 4 * ((self.vocab.n + 31) // 32)
+        if mode == 0:
+            bits = bytearray(b'\xff' * size)
+            # Only '=' can complete the opener and enter a name in one piece.
+            for i in self.vocab._tool_equals:
+                if self._step(state, i) is None:
+                    bits[i >> 3] &= ~(1 << (i & 7))
+            for i in range(self.vocab.n, size * 8):
+                bits[i >> 3] &= ~(1 << (i & 7))
+        else:
+            bits = bytearray(size)
+            first = set(self.WS if not tail or tail in self.names else b'')
+            if tail in self.names:
+                first.add(ord('>'))
+            if mode == 1:
+                first.update(n[len(tail)] for n in self.names if n.startswith(tail) and len(n) > len(tail))
+            for ch in first:
+                for i in self.vocab._tool_buckets.get(ch, ()):
+                    if i not in self.vocab.eos and self._step(state, i) is not None:
+                        bits[i >> 3] |= 1 << (i & 7)
+        result = bytes(bits)
+        with self.vocab._tool_cache_lock:
+            self.cache[state] = result
+            while len(self.cache) > 128:
+                self.cache.popitem(last=False)
+        return result
+
+    def _intersect(self, a, b):
+        if b is None:
+            return a
+        # The engine samples only IDs [0, vocab.n). llguidance 1.9.1 can
+        # return an extra uint32 beyond that range at a word boundary.
+        # Keep our canonical width and intersect every real token bit;
+        # _bits already clears the final word's out-of-vocabulary bits.
+        size = 4 * ((self.vocab.n + 31) // 32)
+        if len(a) != size or len(b) < size or len(b) % 4:
+            raise ValueError('tool-name mask vocabulary width differs from schema mask')
+        return bytes(x & y for x, y in zip(a, b[:size]))
+
+    def mask(self):
+        return self._intersect(self._bits(self.state), self.inner.mask() if self.inner else None)
+
+    def reply(self, drafts=None):
+        if self.failed:
+            raise ValueError(self.failed)
+        drafts = list(drafts or [])
+        inner_rows = None
+        if self.inner:
+            r = self.inner.reply(drafts)
+            parts = r.split()
+            if parts[0] == 'MK':
+                inner_rows = [base64.b64decode(parts[1])]
+            elif parts[0] == 'MKN':
+                inner_rows = [base64.b64decode(b) for b in parts[2:]]
+            elif parts[0] == 'MF':
+                # The JSON matcher is not armed during thinking. Preserve its
+                # cut marker even though our persistent name guard still emits
+                # MKN masks: no draft after </think> may bypass the JSON mask.
+                cut_ids = set()
+                for part in parts[1:]:
+                    if part.startswith('cut='):
+                        cut_ids.update(int(token) for token in part[4:].split(',') if token)
+                for index, token in enumerate(drafts):
+                    if token in cut_ids:
+                        drafts = drafts[:index]
+                        break
+            else:
+                raise ValueError('invalid schema mask reply')
+        rows, state = [], self.state
+        for row in range(len(drafts) + 1):
+            if inner_rows is not None and row >= len(inner_rows):
+                break
+            bits = self._intersect(self._bits(state), inner_rows[row] if inner_rows else None)
+            if not any(bits):
+                raise ValueError('tool-name and schema constraints allow no token')
+            rows.append(bits)
+            if row == len(drafts) or not Constraint.allowed(bits, drafts[row]):
+                break
+            state = self._step(state, drafts[row])
+            if state is None:
+                raise ValueError('accepted draft left tool-name mask')
+        self.masked += len(rows)
+        encoded = [base64.b64encode(b).decode('ascii') for b in rows]
+        return 'MK ' + encoded[0] if len(rows) == 1 else f'MKN {len(rows)} ' + ' '.join(encoded)
+
+    def feed(self, token):
+        state = self._step(self.state, token)
+        if state is None:
+            self.failed = 'engine emitted a token outside the declared tool names'
+            raise ValueError(self.failed)
+        self.state = state
+        if self.inner:
+            self.inner.feed(token)
+            if self.inner.failed not in (None, 'tool call'):
+                raise ValueError('schema mask failed; strict tool mode refuses free decoding')
+
+    def observe(self, ids):
+        for token in ids:
+            self.feed(token)
+
+    def mock_replay(self, script, max_new, cancel, delay=0.0):
+        # The production engine samples these same packed masks. The mock drops
+        # script tokens that violate them, then emits a shortest valid completion.
+        import time
+        script = iter(script)
+        for _ in range(max_new):
+            if cancel.is_set():
+                return
+            if delay:
+                time.sleep(delay)
+            bits = self.mask()
+            token = next((t for t in script if Constraint.allowed(bits, t)), None)
+            if token is None:
+                token = next((t for t in self.vocab.eos if Constraint.allowed(bits, t)), None)
+                if token is None:
+                    token = next((i for i in range(self.vocab.n)
+                                  if Constraint.allowed(bits, i) and self._step(self.state, i) != self.state), None)
+            if token is None:
+                raise ValueError('strict tool-name mock cannot complete the turn')
+            self.feed(token)
+            yield token
+            if token in self.vocab.eos:
+                return
